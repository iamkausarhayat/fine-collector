{
  "rules": {
    "students": {
      ".read": true,
      ".write": "newData.exists()",
      "$studentId": {
        ".validate": "newData.hasChildren(['id', 'name', 'fine', 'date', 'paid'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "fine": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "paid": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "security": {
      ".read": true,
      "admin_devices": {
        ".read": true,
        ".write": true,
        "$deviceId": {
          ".validate": "newData.hasChildren(['id', 'name', 'device', 'status'])"
        }
      },
      "admin_audit_logs": {
        ".read": true,
        "$logId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['actionType', 'details'])"
        }
      },
      "admin_private_keys": {
        ".read": true,
        ".write": true
      },
      "system_master_owner": {
        ".read": true,
        ".write": true
      },
      "master_pin": {
        ".read": false,
        ".write": false
      },
      "master_hash": {
        ".read": false,
        ".write": false
      }
    }
  }
}
