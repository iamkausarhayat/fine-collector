rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Students / Late Fee Records Collection (Zero-Trust Validation)
    match /students/{studentId} {
      // All visitors & students have read-only access
      allow read: if true;
      
      // Strict data schema validation on create
      allow create: if request.resource.data.keys().hasAll(['id', 'name', 'fine', 'date', 'paid'])
                    && request.resource.data.id is string && request.resource.data.id.size() > 0 && request.resource.data.id.size() <= 64
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.fine is number && request.resource.data.fine >= 0 && request.resource.data.fine <= 100000
                    && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
                    && request.resource.data.paid is bool;
                    
      // Strict data schema validation on update
      allow update: if request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
                    && request.resource.data.fine is number && request.resource.data.fine >= 0 && request.resource.data.fine <= 100000
                    && request.resource.data.paid is bool;
                    
      // Deletion of records
      allow delete: if true;
    }
    
    // 2. Admin Devices & Real-time Live Approvals
    match /admin_devices/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'device', 'status'])
                            && request.resource.data.status in ['pending', 'approved', 'rejected', 'revoked']
                            && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if true;
    }
    
    // 3. Tamper-Proof Activity & Audit Logs (Append-Only)
    match /admin_audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['actionType', 'details'])
                    && request.resource.data.actionType is string
                    && request.resource.data.details is string;
      allow update, delete: if false; // Immutable audit trail: cannot modify or delete logs once recorded
    }
    
    // 4. Admin 4-Digit Private Keys generated by Master Mind
    match /admin_private_keys/{keyId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['key', 'name'])
                            && request.resource.data.key is string && request.resource.data.key.size() == 4
                            && request.resource.data.name is string;
      allow delete: if true;
    }
    
    // 5. System Security (Master PIN / Password synchronized from Firestore)
    match /system_security/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
